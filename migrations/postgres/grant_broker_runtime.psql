GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_resolve_principal(text,text,text,text,text,text) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_get_principal(text,uuid) TO :"api_role";
