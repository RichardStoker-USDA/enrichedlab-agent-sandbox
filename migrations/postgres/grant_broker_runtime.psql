GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_bind_scientific_history(text,uuid,text,integer,bigint,uuid,text,text,text,bigint) TO :"worker_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_finalize_scientific_history(text,uuid,text,integer,bigint,bigint) TO :"worker_role";
