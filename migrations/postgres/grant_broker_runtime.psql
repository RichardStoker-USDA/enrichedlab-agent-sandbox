-- Live lab sources (migration 053): the receipt carries the version the lab's database stated.
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_record_query_receipt(text,uuid,text,integer,bigint,text,text,integer,jsonb,text,text,timestamptz,timestamptz,jsonb) TO :"worker_role";
-- Figure versions (migration 040): the API reads the render catalog, requests versions and reads them;
-- the worker keeps the catalog, reads the request of its lease and records one receipt per attempt.
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_render_catalog(text,uuid) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_get_profile_choices(text,uuid) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_list_profile_choices(text,uuid) TO :"api_role";
-- Each lab's methods (migration 052): the workspace offers a lab only the methods granted to it.
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_get_group_methods(text,uuid) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_request_figure(text,uuid,uuid,uuid,text,text,jsonb,text,uuid,uuid) TO :"api_role";
