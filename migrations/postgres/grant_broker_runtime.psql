GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_claim_task(text,text,integer) TO :"worker_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_renew_task(text,uuid,text,bigint,integer) TO :"worker_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_mark_task_running(text,uuid,text,bigint) TO :"worker_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_task_cancel_requested(text,uuid,text,bigint) TO :"worker_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_finish_task(text,uuid,text,bigint,boolean,text,text) TO :"worker_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_register_artifact(text,uuid,text,bigint,text,text,text,text,text,bigint,text) TO :"worker_role";
