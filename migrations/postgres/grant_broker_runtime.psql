GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_record_artifact_digest(text,uuid,text,bigint,text,text,text,jsonb) TO :"worker_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_get_artifact_digest(text,uuid,uuid,uuid) TO :"api_role";

\if :{?custodian_role}
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_custody_task(text,uuid,text,integer,bigint) TO :"custodian_role";
