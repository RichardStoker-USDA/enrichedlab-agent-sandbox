-- Lab datasets (migration 059): the API checks an upload, records the guard's decision, starts an intake
-- that waited for room, records a person's preparation and reads datasets; the worker reads the request of its lease and records one receipt per attempt.
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_dataset_upload_check(text,uuid,uuid,uuid) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_record_dataset(text,uuid,uuid,uuid,text,text,bigint,text,uuid,text,jsonb,text,text,bigint) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_request_dataset_preparation(text,uuid,uuid,uuid,jsonb,text,uuid,uuid) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_project_datasets(text,uuid,uuid) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_dataset_detail(text,uuid,uuid,uuid) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_start_dataset_intake(text,uuid,uuid,uuid) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_task_dataset(text,uuid,text,integer,bigint) TO :"worker_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_record_dataset_receipt(text,uuid,text,integer,bigint,text,text,jsonb,jsonb,text,text,text,bigint,jsonb,text,text,integer,timestamptz,timestamptz) TO :"worker_role";
-- The change feed (migration 061): the API reads each person's changes under that person's access rule,
-- whether work runs in the projects they name, and prunes rows older than a day; `/me` reads each lab's dataset signal.
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_change_feed(text,uuid,xid8,bigint,integer) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_projects_busy(text,uuid,uuid[]) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_prune_changes(text) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_get_group_lab_data(text,uuid) TO :"api_role";
-- Durable campaigns (migration 066). The API acts only for capability holders. The
-- director role is function-only and every mutation is fenced by campaign generation.
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_create_campaign(text,uuid,uuid,text,text,text,jsonb,jsonb,jsonb) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_start_campaign(text,uuid,uuid) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_pause_campaign(text,uuid,uuid) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_resume_campaign(text,uuid,uuid) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_stop_campaign(text,uuid,uuid) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_get_campaign(text,uuid,uuid) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_list_campaigns(text,uuid,text,integer) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_campaign_events_page(text,uuid,uuid,bigint,integer) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_campaign_records_page(text,uuid,uuid,bigint,integer) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_campaign_planner_calls_page(text,uuid,uuid,bigint,integer) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_campaign_planner_text(text,uuid,uuid,text) TO :"api_role";
\if :{?director_role}
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_claim_campaign(text,text,integer) TO :"director_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_renew_campaign(text,uuid,text,bigint,integer) TO :"director_role";
