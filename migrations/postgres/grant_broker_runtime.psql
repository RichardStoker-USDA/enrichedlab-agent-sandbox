GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_get_profiles(text,uuid) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_submit_person_task(text,uuid,text,text,text,text,text) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_list_tasks(text,uuid,integer) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_get_task(text,uuid,uuid) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_request_cancel(text,uuid,uuid) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_list_task_events(text,uuid,uuid,bigint,integer) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_scientific_history_status(text,uuid,uuid,integer,bigint) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_list_scientific_history_events(text,uuid,uuid,integer,bigint,bigint,integer) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_list_scientific_history_events_with_evidence(text,uuid,uuid,integer,bigint,bigint,integer) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_list_scientific_history_evidence(text,uuid,uuid,integer,bigint,uuid,uuid,integer) TO :"api_role";
