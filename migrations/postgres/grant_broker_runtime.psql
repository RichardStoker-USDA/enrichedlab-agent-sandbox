SELECT rolsuper OR rolcreatedb OR rolcreaterole OR rolreplication OR rolbypassrls
  AS api_is_privileged
FROM pg_roles WHERE rolname = :'api_role' \gset
\if :api_is_privileged
  \warn 'API role has forbidden cluster authority'
  \quit 6
\endif

SELECT rolsuper OR rolcreatedb OR rolcreaterole OR rolreplication OR rolbypassrls
  AS worker_is_privileged
FROM pg_roles WHERE rolname = :'worker_role' \gset
\if :worker_is_privileged
  \warn 'worker role has forbidden cluster authority'
  \quit 7
\endif

\if :{?director_role}
SELECT rolsuper OR rolcreatedb OR rolcreaterole OR rolreplication OR rolbypassrls
  AS director_is_privileged
FROM pg_roles WHERE rolname = :'director_role' \gset
\if :director_is_privileged
  \warn 'director role has forbidden cluster authority'
  \quit 17
\endif
\endif

\if :{?custodian_role}
SELECT rolsuper OR rolcreatedb OR rolcreaterole OR rolreplication OR rolbypassrls
  AS custodian_is_privileged
FROM pg_roles WHERE rolname = :'custodian_role' \gset
\if :custodian_is_privileged
  \warn 'custodian role has forbidden cluster authority'
  \quit 12
\endif
\endif

SELECT EXISTS (
  SELECT 1
  FROM pg_class AS relation
  JOIN pg_namespace AS namespace ON namespace.oid = relation.relnamespace
  WHERE namespace.nspname = 'enrichedlab_agent'
    AND relation.relowner IN (to_regrole(:'api_role')::oid, to_regrole(:'worker_role')::oid)
) AS runtime_owns_relation \gset
\if :runtime_owns_relation
  \warn 'runtime roles must not own broker relations'
  \quit 8
\endif

\if :{?director_role}
SELECT EXISTS (
  SELECT 1
  FROM pg_class AS relation
  JOIN pg_namespace AS namespace ON namespace.oid = relation.relnamespace
  WHERE namespace.nspname = 'enrichedlab_agent'
    AND relation.relowner = to_regrole(:'director_role')::oid
) AS director_owns_relation \gset
\if :director_owns_relation
  \warn 'director role must not own broker relations'
  \quit 17
\endif
\endif

\if :{?custodian_role}
SELECT EXISTS (
  SELECT 1
  FROM pg_class AS relation
  JOIN pg_namespace AS namespace ON namespace.oid = relation.relnamespace
  WHERE namespace.nspname = 'enrichedlab_agent'
    AND relation.relowner = to_regrole(:'custodian_role')::oid
) AS custodian_owns_relation \gset
\if :custodian_owns_relation
  \warn 'custodian role must not own broker relations'
  \quit 13
\endif
\endif

SELECT NOT (
  coalesce(rolconfig, ARRAY[]::text[]) @> ARRAY[
    'statement_timeout=30s',
    'lock_timeout=5s',
    'idle_in_transaction_session_timeout=30s'
  ]
) AS api_timeouts_missing
FROM pg_roles WHERE rolname = :'api_role' \gset
\if :api_timeouts_missing
  \warn 'API role is missing bounded database timeouts'
  \quit 9
\endif

SELECT NOT (
  coalesce(rolconfig, ARRAY[]::text[]) @> ARRAY[
    'statement_timeout=30s',
    'lock_timeout=5s',
    'idle_in_transaction_session_timeout=30s'
  ]
) AS worker_timeouts_missing
FROM pg_roles WHERE rolname = :'worker_role' \gset
\if :worker_timeouts_missing
  \warn 'worker role is missing bounded database timeouts'
  \quit 10
\endif

\if :{?director_role}
SELECT NOT (
  coalesce(rolconfig, ARRAY[]::text[]) @> ARRAY[
    'statement_timeout=30s',
    'lock_timeout=5s',
    'idle_in_transaction_session_timeout=30s'
  ]
) AS director_timeouts_missing
FROM pg_roles WHERE rolname = :'director_role' \gset
\if :director_timeouts_missing
  \warn 'director role is missing bounded database timeouts'
  \quit 18
\endif
\endif

\if :{?custodian_role}
SELECT NOT (
  coalesce(rolconfig, ARRAY[]::text[]) @> ARRAY[
    'statement_timeout=30s',
    'lock_timeout=5s',
    'idle_in_transaction_session_timeout=30s'
  ]
) AS custodian_timeouts_missing
FROM pg_roles WHERE rolname = :'custodian_role' \gset
\if :custodian_timeouts_missing
  \warn 'custodian role is missing bounded database timeouts'
  \quit 14
\endif
\endif

