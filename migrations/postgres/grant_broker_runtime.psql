\set ON_ERROR_STOP on

-- Run as the migration owner. API and worker login roles must already exist
-- and be distinct. Optional director and custodian login roles receive only
-- their lease-fenced functions; neither is a migration-owner substitute.
\if :{?api_role}
\else
  \warn 'api_role is required'
  \quit 3
\endif
\if :{?worker_role}
\else
  \warn 'worker_role is required'
  \quit 4
\endif
SELECT :'api_role' = :'worker_role' AS roles_match \gset
\if :roles_match
  \warn 'api_role and worker_role must be different'
  \quit 5
\endif
\if :{?director_role}
SELECT :'director_role' IN (:'api_role', :'worker_role') AS director_role_matches \gset
\if :director_role_matches
  \warn 'director_role must differ from api_role and worker_role'
  \quit 16
\endif
\endif

\if :{?custodian_role}
SELECT :'custodian_role' IN (:'api_role', :'worker_role') AS custodian_role_matches \gset
\if :custodian_role_matches
  \warn 'custodian_role must differ from api_role and worker_role'
  \quit 11
\endif
\if :{?director_role}
SELECT :'custodian_role' = :'director_role' AS custodian_matches_director \gset
\if :custodian_matches_director
  \warn 'custodian_role must differ from director_role'
  \quit 11
\endif
\endif
\endif

-- Refuse a reused director login before ALTER/REVOKE could hide its prior authority.
-- A correctly provisioned role may be passed again: the predicate admits only this
-- script's schema USAGE and campaign-function grants.
\if :{?director_role}
SELECT NOT enrichedlab_agent.broker_campaign_director_role_safe(:'director_role'::name)
  AS director_role_unsafe \gset
\if :director_role_unsafe
  \warn 'director role is not function-only'
  \quit 17
\endif
\endif

ALTER ROLE :"api_role"
  NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOREPLICATION NOBYPASSRLS;
ALTER ROLE :"worker_role"
  NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOREPLICATION NOBYPASSRLS;
\if :{?director_role}
ALTER ROLE :"director_role"
  NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOREPLICATION NOBYPASSRLS;
\endif
\if :{?custodian_role}
ALTER ROLE :"custodian_role"
  NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOREPLICATION NOBYPASSRLS;
\endif
ALTER ROLE :"api_role" SET statement_timeout = '30s';
ALTER ROLE :"api_role" SET lock_timeout = '5s';
ALTER ROLE :"api_role" SET idle_in_transaction_session_timeout = '30s';
ALTER ROLE :"worker_role" SET statement_timeout = '30s';
ALTER ROLE :"worker_role" SET lock_timeout = '5s';
ALTER ROLE :"worker_role" SET idle_in_transaction_session_timeout = '30s';
\if :{?director_role}
ALTER ROLE :"director_role" SET statement_timeout = '30s';
ALTER ROLE :"director_role" SET lock_timeout = '5s';
ALTER ROLE :"director_role" SET idle_in_transaction_session_timeout = '30s';
\endif
\if :{?custodian_role}
ALTER ROLE :"custodian_role" SET statement_timeout = '30s';
ALTER ROLE :"custodian_role" SET lock_timeout = '5s';
ALTER ROLE :"custodian_role" SET idle_in_transaction_session_timeout = '30s';
\endif

GRANT CONNECT ON DATABASE :DBNAME TO :"api_role", :"worker_role";
GRANT USAGE ON SCHEMA enrichedlab_agent TO :"api_role", :"worker_role";
\if :{?director_role}
GRANT CONNECT ON DATABASE :DBNAME TO :"director_role";
GRANT USAGE ON SCHEMA enrichedlab_agent TO :"director_role";
\endif
\if :{?custodian_role}
GRANT CONNECT ON DATABASE :DBNAME TO :"custodian_role";
GRANT USAGE ON SCHEMA enrichedlab_agent TO :"custodian_role";
\endif
REVOKE CREATE ON SCHEMA public FROM :"api_role", :"worker_role";
REVOKE CREATE ON SCHEMA enrichedlab_agent FROM :"api_role", :"worker_role";
REVOKE ALL ON ALL TABLES IN SCHEMA enrichedlab_agent FROM :"api_role", :"worker_role";
REVOKE ALL ON ALL SEQUENCES IN SCHEMA enrichedlab_agent FROM :"api_role", :"worker_role";
REVOKE ALL ON ALL FUNCTIONS IN SCHEMA enrichedlab_agent FROM :"api_role", :"worker_role";
\if :{?director_role}
REVOKE CREATE ON SCHEMA public FROM :"director_role";
REVOKE CREATE ON SCHEMA enrichedlab_agent FROM :"director_role";
REVOKE ALL ON ALL TABLES IN SCHEMA enrichedlab_agent FROM :"director_role";
REVOKE ALL ON ALL SEQUENCES IN SCHEMA enrichedlab_agent FROM :"director_role";
REVOKE ALL ON ALL FUNCTIONS IN SCHEMA enrichedlab_agent FROM :"director_role";
\endif
\if :{?custodian_role}
REVOKE CREATE ON SCHEMA public FROM :"custodian_role";
REVOKE CREATE ON SCHEMA enrichedlab_agent FROM :"custodian_role";
REVOKE ALL ON ALL TABLES IN SCHEMA enrichedlab_agent FROM :"custodian_role";
REVOKE ALL ON ALL SEQUENCES IN SCHEMA enrichedlab_agent FROM :"custodian_role";
REVOKE ALL ON ALL FUNCTIONS IN SCHEMA enrichedlab_agent FROM :"custodian_role";
\endif

GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_schema_ready(integer) TO :"api_role", :"worker_role";
\if :{?director_role}
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_schema_ready(integer) TO :"director_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_campaign_director_ready() TO :"director_role";
\endif

