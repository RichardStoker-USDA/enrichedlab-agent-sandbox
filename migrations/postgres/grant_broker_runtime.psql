GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_finish_figure_preview(text,text,uuid,text,bytea,jsonb) TO :"worker_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_sweep_figure_previews(text) TO :"worker_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_record_render_catalog(text,text,text,text,jsonb) TO :"worker_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_task_figure(text,uuid,text,integer,bigint) TO :"worker_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_record_figure_receipt(text,uuid,text,integer,bigint,text,text,text,text,text,jsonb,jsonb,text,timestamptz,timestamptz) TO :"worker_role";
-- Template analyses (migration 058): the API reads the analysis catalog, requests analyses and reads
-- them; the worker keeps the catalog, reads the request of its lease and records one receipt per attempt.
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_analysis_catalog(text,uuid) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_request_analysis(text,uuid,uuid,uuid,text,text,jsonb,text,uuid,uuid) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_task_analysis_detail(text,uuid,uuid) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_analysis_versions(text,uuid,uuid) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_record_analysis_catalog(text,text,text,text,jsonb) TO :"worker_role";
