GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_campaign_finished_steps(text,uuid,text,bigint) TO :"director_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_campaign_apply(text,uuid,text,bigint,jsonb) TO :"director_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_start_campaign_step(text,uuid,text,bigint,uuid,uuid,text,text,text[],uuid,uuid) TO :"director_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_start_campaign_planner_call(text,uuid,text,bigint,uuid,bytea,text) TO :"director_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_finish_campaign_planner_call(text,uuid,text,bigint,uuid,bytea,text,text) TO :"director_role";
SELECT NOT enrichedlab_agent.broker_campaign_director_role_safe(:'director_role'::name)
  AS director_role_unsafe_after_grants \gset
\if :director_role_unsafe_after_grants
  \warn 'director role is not function-only after provisioning'
  \quit 17
\endif
\endif
\if :{?custodian_role}
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_custody_admitted_code(text,uuid,text,integer,bigint) TO :"custodian_role";
\endif

-- Migration 070: literature review artifacts for project lab members.
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_literature_review(text,uuid,uuid,text) TO :"api_role";
-- Migration 074: a lab member's read of a run's checked orientation.
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_research_orientation(text,uuid,uuid) TO :"api_role";

-- Migration 072: answer documents. People ask for and read them; the worker builds them under its lease.
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_request_document(text,uuid,uuid,uuid,text,uuid) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_task_document_detail(text,uuid,uuid) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_run_documents(text,uuid,uuid) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_task_document(text,uuid,text,integer,bigint) TO :"worker_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_record_document_receipt(text,uuid,text,integer,bigint,text,text,text,text,text,jsonb,jsonb,jsonb,text,timestamptz,timestamptz) TO :"worker_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_complete_document(text,uuid,text,integer,bigint,text,text,jsonb,jsonb,jsonb,text,bigint,text,text,bigint,text,text,jsonb,timestamptz,timestamptz) TO :"worker_role";

-- Migration 075: the evidence record. The API and worker roles append as their registered broker producers; the API
-- verifies a stream's chain for the signed-in person, who must be allowed to read it, and names a purpose; the worker
-- keeps the monthly partitions ahead. No role gets a table privilege.
GRANT USAGE ON SCHEMA evidence TO :"api_role", :"worker_role";
GRANT EXECUTE ON FUNCTION evidence.append(text,text,text,text,uuid,uuid,text,text,timestamptz,text,text) TO :"api_role", :"worker_role";
GRANT EXECUTE ON FUNCTION evidence.verify_stream(text,uuid,uuid,text) TO :"api_role";
GRANT EXECUTE ON FUNCTION evidence.ensure_record_partitions(integer) TO :"worker_role";

-- Migration 076: the lineage graph. evidence.append writes it; the API reads one activity's provenance for a person who
-- may read its stream.
GRANT EXECUTE ON FUNCTION evidence.trace_activity(text,uuid,uuid,text,text) TO :"api_role";

-- The gRPC evidence append service's database role (optional): it may append, read which producers are bound to it,
-- and keep the coming months' partitions, and nothing else. Which producers it may name is the
-- evidence.adapter_bindings rows the migration owner writes for it.
\if :{?evidence_adapter_role}
GRANT USAGE ON SCHEMA evidence TO :"evidence_adapter_role";
GRANT EXECUTE ON FUNCTION evidence.append(text,text,text,text,uuid,uuid,text,text,timestamptz,text,text) TO :"evidence_adapter_role";
GRANT EXECUTE ON FUNCTION evidence.adapter_producers(text) TO :"evidence_adapter_role";
-- Partition upkeep is bounded to twelve months and only creates missing empty partitions.
GRANT EXECUTE ON FUNCTION evidence.ensure_record_partitions(integer) TO :"evidence_adapter_role";
-- Migration 079: the same service is the custody writer. Each function checks that the producer is bound to this role
-- and holds a custody.store grant for the scope; only the service's own observations (a missing copy, an applied
-- retention, a new epoch) are written without a producer.
GRANT EXECUTE ON FUNCTION evidence.custody_authorise(text,text,text,text,uuid,uuid) TO :"evidence_adapter_role";
GRANT EXECUTE ON FUNCTION evidence.custody_issue_claim(text,text,text,text,uuid,uuid,text,text,bigint,text,text,bigint,text,text,timestamptz,boolean) TO :"evidence_adapter_role";
GRANT EXECUTE ON FUNCTION evidence.custody_record_copy(text,uuid,text,text,bigint,text,text,timestamptz,boolean) TO :"evidence_adapter_role";
GRANT EXECUTE ON FUNCTION evidence.custody_mark_ready(text,text,uuid,uuid) TO :"evidence_adapter_role";
GRANT EXECUTE ON FUNCTION evidence.custody_claim(text,text,uuid) TO :"evidence_adapter_role";
GRANT EXECUTE ON FUNCTION evidence.custody_waiting(text,integer,uuid) TO :"evidence_adapter_role";
GRANT EXECUTE ON FUNCTION evidence.custody_due_copies(text,interval,integer) TO :"evidence_adapter_role";
GRANT EXECUTE ON FUNCTION evidence.custody_retention_pending(text,integer) TO :"evidence_adapter_role";
GRANT EXECUTE ON FUNCTION evidence.custody_observe(text,uuid,uuid,text,jsonb) TO :"evidence_adapter_role";
GRANT EXECUTE ON FUNCTION evidence.custody_epoch_check(text) TO :"evidence_adapter_role";
GRANT EXECUTE ON FUNCTION evidence.custody_complete_acceptances(text) TO :"evidence_adapter_role";
-- Migration 081: the same service runs the capture recorder, which records only what the capture triggers logged, and
-- reads the log's age (a number) to warn when recording falls behind even while its recorder calls fail.
-- It calls the procedure, which commits before and after recording; the function itself refuses this role unless reached
-- through that call.
GRANT EXECUTE ON PROCEDURE evidence.capture_record_now(integer, jsonb) TO :"evidence_adapter_role";
GRANT EXECUTE ON FUNCTION evidence.capture_record(integer) TO :"evidence_adapter_role";
GRANT EXECUTE ON FUNCTION evidence.capture_log_age() TO :"evidence_adapter_role";
-- The same timeouts as the other runtime roles: a transaction of this role cannot hold a lock idle or wait unbounded.
ALTER ROLE :"evidence_adapter_role" SET statement_timeout = '30s';
ALTER ROLE :"evidence_adapter_role" SET lock_timeout = '5s';
ALTER ROLE :"evidence_adapter_role" SET idle_in_transaction_session_timeout = '30s';
\endif

-- Migration 079: a lab's lead approves its records class through the API.
GRANT EXECUTE ON FUNCTION evidence.custody_approve_records_class(text,uuid,text,interval,uuid,interval,text) TO :"api_role";
GRANT EXECUTE ON FUNCTION evidence.custody_acceptance_state(text,uuid) TO :"api_role";

-- Migration 080: a lab member reads the lab's tools, their tool groups and how each is granted.
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_lab_tools(text,uuid,text) TO :"api_role";
