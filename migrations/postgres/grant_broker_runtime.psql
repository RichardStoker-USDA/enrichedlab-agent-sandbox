GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_figure_versions(text,uuid,uuid) TO :"api_role";
-- Migration 057: figure previews and the manuscript mark.
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_request_figure_preview(text,uuid,uuid,uuid,text,text,jsonb,text) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_take_figure_preview(text,uuid,uuid) TO :"api_role";
GRANT EXECUTE ON FUNCTION enrichedlab_agent.broker_abandon_figure_preview(text,uuid,uuid) TO :"api_role";
