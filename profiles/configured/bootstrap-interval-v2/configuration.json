{
  "schema": "enrichedlab.configured-block.v1",
  "settings": {
    "groups": {
      "label": "Groups",
      "choices": {
        "supplement": {
          "label": "each delivery method (supplement), all doses together",
          "slots": {"groups": "data$supp", "groups_words": "delivery method", "groups_label": "\"Delivery method\""}
        },
        "dose": {
          "label": "each dose, both delivery methods together",
          "slots": {"groups": "data$dose", "groups_words": "dose", "groups_label": "\"Dose (mg per day)\""}
        },
        "supplement_and_dose": {
          "label": "each delivery method and dose combination",
          "slots": {"groups": "interaction(data$supp, data$dose, drop = TRUE, lex.order = TRUE)",
                    "groups_words": "delivery method and dose", "groups_label": "\"Delivery method and dose\""}
        }
      }
    },
    "statistic": {
      "label": "Statistic",
      "choices": {
        "mean": {"label": "mean", "slots": {"statistic": "mean"}},
        "median": {"label": "median", "slots": {"statistic": "median"}}
      }
    },
    "resamples": {
      "label": "Resamples per group",
      "choices": {
        "2000": {"label": "2,000", "slots": {"resamples": "2000"}},
        "10000": {"label": "10,000", "slots": {"resamples": "10000"}},
        "20000": {"label": "20,000", "slots": {"resamples": "20000"}}
      }
    },
    "level": {
      "label": "Interval level",
      "choices": {
        "90": {"label": "90%", "slots": {"level": "0.90"}},
        "95": {"label": "95%", "slots": {"level": "0.95"}},
        "99": {"label": "99%", "slots": {"level": "0.99"}}
      }
    }
  }
}
