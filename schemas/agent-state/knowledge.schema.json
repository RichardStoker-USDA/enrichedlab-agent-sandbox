{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "enrichedlab://agent-state/knowledge/v1",
  "title": "Working knowledge state",
  "type": "object",
  "additionalProperties": false,
  "required": ["facts", "hypotheses", "decisions", "lessons", "rejected"],
  "properties": {
    "facts": {"type": "object", "maxProperties": 2000, "additionalProperties": {"$ref": "#/$defs/assertion"}},
    "hypotheses": {"type": "object", "maxProperties": 1000, "additionalProperties": {"$ref": "#/$defs/hypothesis"}},
    "decisions": {"type": "object", "maxProperties": 1000, "additionalProperties": {"$ref": "#/$defs/decision"}},
    "lessons": {"type": "object", "maxProperties": 1000, "additionalProperties": {"$ref": "#/$defs/lesson"}},
    "rejected": {"type": "object", "maxProperties": 1000, "additionalProperties": {"$ref": "#/$defs/assertion"}}
  },
  "$defs": {
    "evidence": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
    "assertion": {
      "type": "object", "additionalProperties": false, "required": ["statement", "evidence", "confidence"],
      "properties": {
        "statement": {"type": "string", "minLength": 1, "maxLength": 8192},
        "evidence": {"$ref": "#/$defs/evidence"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "hypothesis": {
      "type": "object", "additionalProperties": false, "required": ["statement", "status", "evidence"],
      "properties": {
        "statement": {"type": "string", "minLength": 1, "maxLength": 8192},
        "status": {"type": "string", "enum": ["untested", "testing", "supported", "rejected", "inconclusive"]},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false, "required": ["choice", "rationale", "evidence"],
      "properties": {
        "choice": {"type": "string", "minLength": 1, "maxLength": 4096},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 8192},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "lesson": {
      "type": "object", "additionalProperties": false, "required": ["lesson", "trigger", "evidence"],
      "properties": {
        "lesson": {"type": "string", "minLength": 1, "maxLength": 8192},
        "trigger": {"type": "string", "minLength": 1, "maxLength": 4096},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    }
  }
}
