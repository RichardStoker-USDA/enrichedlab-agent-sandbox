{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "enrichedlab://agent-state/execution/v1",
  "title": "Execution state",
  "type": "object",
  "additionalProperties": false,
  "required": ["objective", "phase", "completed", "pending", "blockers", "next_action", "retry_count", "last_observation_ref"],
  "properties": {
    "objective": {"type": "string", "minLength": 1, "maxLength": 8192},
    "phase": {"type": "string", "minLength": 1, "maxLength": 256},
    "completed": {
      "type": "object",
      "maxProperties": 512,
      "additionalProperties": {"$ref": "#/$defs/work_item"}
    },
    "pending": {
      "type": "object",
      "maxProperties": 512,
      "additionalProperties": {"$ref": "#/$defs/work_item"}
    },
    "blockers": {
      "type": "object",
      "maxProperties": 128,
      "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "next_action": {"type": ["string", "null"], "maxLength": 4096},
    "retry_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "last_observation_ref": {"type": ["string", "null"], "maxLength": 1024}
  },
  "$defs": {
    "work_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "evidence"],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 4096},
        "evidence": {
          "type": "array",
          "maxItems": 64,
          "items": {"type": "string", "minLength": 1, "maxLength": 1024}
        }
      }
    }
  }
}
